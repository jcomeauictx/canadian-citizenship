/bullet {(\267) show} bind def
/check {
 gsave 
 /ZapfDingbats 10 selectfont
 (4) show currentpoint
 grestore
 moveto
} bind def
/showstack {(stack: ) =only count array astore ==} bind def
{ARGUMENTS} stopped {[]} if {0 get} stopped {pop ()} if (test) eq
 {
  /Courier 24 selectfont
  100 100 moveto check bullet showpage
  (after showpage ) =only showstack
 }
 {((check.ps definitions loaded) ) =only showstack}
 ifelse
(check.ps end ) =only showstack
