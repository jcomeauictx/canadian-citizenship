/bullet {(\267) show} bind def
/check {
 gsave 
 /ZapfDingbats 10 selectfont
 (4) show currentpoint
 grestore
 moveto
} bind def
{ARGUMENTS dup == 0 get} stopped {()} if pstack (test) eq
 {
  /Courier 10 selectfont
  100 100 moveto check bullet showpage
 }
 {((check.ps definitions loaded)) =}
 ifelse
