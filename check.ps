/bullet {
 gsave
 /ZapfDingbats 8 selectfont
 (l) show currentpoint
 grestore
 moveto
} bind def
/check {
 gsave 
 /ZapfDingbats 8 selectfont
 (4) show currentpoint
 grestore
 moveto
} bind def
{ARGUMENTS} stopped {[]} if {0 get} stopped {pop pop ()} if (test) eq
 {
  /Courier 24 selectfont
  100 100 moveto check bullet showpage
 }
 {((check.ps definitions loaded)) =}
 ifelse
