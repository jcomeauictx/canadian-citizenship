/lineheight 7.2 def  % half of actual input box height
/showstack {(stack: ) =only count array astore dup == aload pop} bind def
(check.ps) run
showstack
(copying showpage to showpage.orig) =
/showpage where {/showpage get /showpage.orig exch def} if
/inches {72 mul} bind def
/addsuffix {  % (base) (.suffix) addsuffix - (base.suffix)
 2 copy length exch length add string  % make new string for result
 dup 0 4 index putinterval
 dup 4 -1 roll length 4 -1 roll putinterval
} bind def
(redefining showpage) =
/typeshow {
 (displaying: ) =only dup =
 dup type /stringtype eq {show} {exec} ifelse
} bind def
(before creating Courier-latin1 ) =only showstack
/Courier findfont
dup length dict begin
 {1 index /FID ne {def} {pop pop} ifelse} forall
 /Encoding ISOLatin1Encoding def
 currentdict
end
/Courier-Latin1 exch definefont
pop  % remove Courier fontdict
(after creating Courier-latin1 ) =only showstack
/showpage {
 showstack
 /fontsize 10 def
 /Courier-Latin1 fontsize selectfont
 /spacewidth ( ) stringwidth pop def
 currentpagedevice /PageSize get 1 get /pageheight exch def
 0 pageheight lineheight sub moveto
 {
  dup token % gets row number
  {
   1 index token pop  % column number
   exch lineheight mul pageheight exch sub 0 exch  % start of line
   (moving to page height ) =only dup 10 string cvs = moveto
   dup (advancing ) =only 10 string cvs =only ( spaces) =
   spacewidth mul 0 rmoveto  % space to where text goes
   dup token pop typeshow}
  {pop exit}
  ifelse
 } loop
 showpage.orig
} bind def
{ARGUMENTS showstack} stopped {[]} if
 {dup 0 get} stopped
  {pop pop (must specify input files) = quit}
  {
   {exch 1 index 1 get} stopped {pop dup (.txt) addsuffix} if
   {(r) file} stopped {pop pop (/dev/null) (r) file} if
   exch dup (running ) =only = run
  }
  ifelse
  pop
  (at end ) =only showstack
