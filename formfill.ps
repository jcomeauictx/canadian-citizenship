/fontsize 10 def
/linespace 7.2 def  % half of actual input box height
/testline (0123456789012345678901234567890123456789) def
/Courier fontsize selectfont
/showstack {
 (stack: ) =only count array astore dup == aload pop
} bind def
showstack
(check.ps) run
showstack
(copying showpage to showpage.orig) =
/showpage where {/showpage get /showpage.orig exch def} if
/inches {72 mul} bind def
/addsuffix {  % (base) (.suffix) addsuffix - (base.suffix)
 2 copy length exch length add string  % make new string for result
 dup 0 4 index putinterval
 dup 4 -1 roll length 4 -1 roll putinterval
} bind def
%(testing) (.this) addsuffix showstack quit
(redefining showpage) =
/showpage {
	showstack
	currentpagedevice /PageSize get 1 get /pageheight exch def
	0 pageheight linespace sub moveto
	/line 1 def
	60 {
		gsave
			testline show testline show
			( ) show line 100 add 3 string cvs 1 2 getinterval show
		grestore
		/line line 1 add def
		0 linespace neg rmoveto} repeat
	showpage.orig
} bind def
showstack
(ARGUMENTS: ) =only ARGUMENTS ===
ARGUMENTS 0 get dup
(.txt) addsuffix {(r) file} stopped {pop pop} {exch} ifelse
(before running ) =only showstack
run
