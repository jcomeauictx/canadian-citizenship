/fontsize 10 def
/linespace 7.2 def  % half of actual form input field height
/testline (0123456789012345678901234567890123456789) def
/Courier fontsize selectfont
(copying showpage to showpage.orig) =
/inches {72 mul} bind def
/zeropad {  % number digits - string
 dup 10 exch exp cvi
 3 -1 roll add 1 index 1 add string cvs
 exch 1 exch getinterval
} bind def
/testfill {
 /line 1 def
 120 {
  gsave
   testline show testline show
   ( ) show line 3 zeropad show
  grestore
  /line line 1 add def
  0 linespace neg rmoveto
 } repeat
} bind def
(redefining showpage) =
/showpage where {/showpage get /showpage.orig exch def} if
/showpage {
 currentpagedevice /PageSize get 1 get /pageheight exch def
 0 inches pageheight linespace sub moveto
 testfill
 showpage.orig
} bind def
(ARGUMENTS: ) =only ARGUMENTS ===
ARGUMENTS 0 get dup
(running ) =only = run
