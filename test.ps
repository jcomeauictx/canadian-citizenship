/lineheight 7.2 def  % half of actual form input field height
/zeropad {  % number digits - string
 dup 10 exch exp cvi
 3 -1 roll add 1 index 1 add string cvs
 exch 1 exch getinterval
} bind def
/showstack {(stack: ) =only count array astore dup == aload pop} bind def
/testfill {
 /testline (0123456789012345678901234567890123456789) def
 /fontsize 10 def
 /Courier fontsize selectfont
 /line 1 def
 120 {
  gsave
   testline show testline show
   ( ) show line 3 zeropad show
  grestore
  /line line 1 add def
  0 lineheight neg rmoveto
 } repeat
} bind def
(copying showpage to showpage.orig) =
/showpage where {/showpage get /showpage.orig exch def} if
(redefining showpage) =
/showpage {
 currentpagedevice /PageSize get 1 get /pageheight exch def
 0 pageheight lineheight sub moveto
 testfill
 showpage.orig
} bind def
{ARGUMENTS showstack} stopped {[]} if
 {0 get} stopped
  {pop pop ()} if
   dup length 0 eq
   {pop ((check.ps definitions loaded)) =}
   {showstack dup (running ) =only = run}
   ifelse
